# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Xml-Light is a minimal XML parser & printer for OCaml"
description:
  "It provide functions to parse an XML document into an OCaml data structure, work with it, and print it back to an XML document. It support also DTD parsing and checking, and is entirely written in OCaml, hence it does not require any additional C library."
maintainer: [
  "Nicolas Cannasse <ncannasse@gmail.com>"
  "Hugo Heuzard <hugo.heuzard@nomadic-labs.com>"
]
authors: ["Nicolas Cannasse <ncannasse@gmail.com>"]
license: "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception"
homepage: "https://github.com/ncannasse/xml-light"
bug-reports: "https://github.com/ncannasse/xml-light/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {> "4.03"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ncannasse/xml-light.git"
